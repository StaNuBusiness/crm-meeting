{
    "name": "nncodes/laravel-meeting",
    "description": "Handle online meeting with Laravel",
    "keywords": [
        "nncodes",
        "laravel-meeting"
    ],
    "homepage": "https://github.com/99codes/laravel-meeting",
    "license": "MIT",
    "authors": [
        {
            "name": "Leonardo Poletto",
            "email": "lgupoletto@gmail.com",
            "homepage": "https://99codes.com.br",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/StaNuBusiness/laravel-meta-attributes"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2",
        "guzzlehttp/guzzle": "^6.0|^7.0|^7.2",
        "illuminate/contracts": "^9.0|^10.0|^11.0",
        "stanubusiness/laravel-meta-attributes": "2.1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4|^11.5"
    },
    "autoload": {
        "psr-4": {
            "Nncodes\\Meeting\\": "src",
            "Nncodes\\Meeting\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nncodes\\Meeting\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nncodes\\Meeting\\MeetingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
